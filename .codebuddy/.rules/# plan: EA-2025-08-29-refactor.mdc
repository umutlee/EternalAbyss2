             }
         }
(將建築管理中的查詢由使用 BuildingData 改為 BuildingTemplateSO。buildingTemplate 表示某建築類型對應的模板資產。) 完成以上重構後，遊戲的靜態數據全部透過 ScriptableObject 提供。程式碼對資料的讀取都是強類型存取，消除了先前由於 object 類型導致的錯誤並提高了資料修改的靈活性。
第三階段：服務定位器模式
10. 建立 ServiceLocator 類別
集中管理服務實例的註冊與查找： WRITE_CHANGE DeepAbyssHive/Core/Services/ServiceLocator.cs（新增服務定位器類別）:
csharp
Copy code
using System;
using System.Collections.Generic;

namespace DeepAbyssHive.Core.Services
{
    /// <summary>全域服務定位器，用於註冊和獲取服務</summary>
    public static class ServiceLocator
    {
        private static readonly Dictionary<Type, object> _services = new Dictionary<Type, object>();

        /// <summary>註冊服務實例</summary>
        public static void Register<TService>(TService service)
        {
            _services[typeof(TService)] = service;
        }

        /// <summary>獲取服務實例</summary>
        public static TService Get<TService>()
        {
            object service;
            if(_services.TryGetValue(typeof(TService), out service))
            {
                return (TService)service;
            }
            else
            {
                throw new Exception($"Service not registered: {typeof(TService)}");
            }
        }
    }
}
11. 核心服務集中註冊
新增啟動腳本，於遊戲開始時實例化並註冊所有核心服務： WRITE_CHANGE DeepAbyssHive/Core/Managers/GameBootstrapper.cs（遊戲啟動註冊腳本）:
csharp
Copy code
using UnityEngine;
using DeepAbyssHive.Core.Services;
using DeepAbyssHive.Creep.Interfaces;
using DeepAbyssHive.Creep.Services;
using DeepAbyssHive.Buildings.Services;

namespace DeepAbyssHive.Core.Managers
{
    /// <summary>遊戲啟動時註冊核心服務的腳本</summary>
    public class GameBootstrapper : MonoBehaviour
    {
        void Awake()
        {
            // 創建各核心服務實例
            var creepGridService = new CreepGridService();
            var creepSourceService = new CreepSourceService();
            var creepNetworkService = new CreepNetworkService();
            var creepQueryService = new CreepQueryService(creepGridService, creepSourceService, creepNetworkService);
            var buildingQueryService = new BuildingQueryService();
            var buildingConstructionService = new BuildingConstructionService();
            // 如有其他服務（例如 CreepSimulationService 等）也可在此初始化

            // 註冊服務實例到 ServiceLocator
            ServiceLocator.Register<ICreepGridService>(creepGridService);
            ServiceLocator.Register<ICreepSourceService>(creepSourceService);
            ServiceLocator.Register<ICreepNetworkService>(creepNetworkService);
            ServiceLocator.Register<ICreepQueryService>(creepQueryService);
            ServiceLocator.Register<IBuildingQueryService>(buildingQueryService);
            ServiceLocator.Register<IBuildingConstructionService>(buildingConstructionService);
            // 將來可在此註冊更多服務...
        }
    }
}
(上述 GameBootstrapper 腳本需掛載於啟動場景的物件，以確保 Awake 時執行服務的初始化和註冊。)
