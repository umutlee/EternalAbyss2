第二階段：資料驅動重構（ScriptableObject）
6. 新增單位與建築模板 ScriptableObject 類別
建立 ScriptableObject 類別，用於保存單位和建築的靜態資料： WRITE_CHANGE DeepAbyssHive/Units/Data/UnitTemplateSO.cs（單位資料模板 ScriptableObject 類）:
csharp
Copy code
using UnityEngine;
using DeepAbyssHive.Units.Enums;
using DeepAbyssHive.Buildings.Enums;
using DeepAbyssHive.Creep.Enums;
using DeepAbyssHive.Terrain.Enums;

namespace DeepAbyssHive.Units.Data
{
    /// <summary>單位靜態屬性模板（ScriptableObject）</summary>
    [CreateAssetMenu(fileName = "UnitTemplate", menuName = "DeepAbyssHive/Unit Template", order = 1)]
    public class UnitTemplateSO : ScriptableObject
    {
        public int Id;
        public UnitType UnitType;
        public string UnitName;
        public string Description;
        public int Level;
        public float BaseHealth;
        public float BaseEnergy;
        public float BaseShield;
        public float BaseMoveSpeed;
        public float BaseAttackDamage;
        public float BaseAttackRange;
        public float BaseAttackSpeed;
        public float BaseArmor;
        public float HealthGrowth;
        public float EnergyGrowth;
        public float DamageGrowth;
        public float ArmorGrowth;
        public float SpeedGrowth;
        public EnvironmentType PreferredEnvironment;
        public float EnvironmentAdaptationRate;
        public bool IsAggressive;
        public bool CanFlee;
        public float AggroRange;
        public float PatrolRadius;
        public float FleeHealthThreshold;
        public bool CanEvolve;
        public UnitType NextEvolution;  // 下階段進化的單位類型（若僅單一路線）
        public List<UnitType> EvolutionPath;  // 可進化的單位類型列表
        public Dictionary<UnitType, float> EvolutionRequirements;  // 每種進化所需條件（如經驗值）
        public float EvolutionCost;
        public List<string> AvailableSkills;
        public Dictionary<string, float> SkillCooldowns;
        public Dictionary<string, float> SkillDamage;
        public Dictionary<string, float> CreationCost;
        public Dictionary<string, float> MaintenanceCost;
    }
}
