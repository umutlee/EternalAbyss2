using System;
using UnityEngine;
using DeepAbyssHive.Common.Placement;
using DeepAbyssHive.Game.Config;

namespace DeepAbyssHive.Common.Placement
{
    /// <summary>
    /// 放置驗證幫手：依 GameConfigSO 執行碰撞/邊界/菌毯等檢查，回傳 Result&lt;Bounds&gt;。
    /// 目標：讓呼叫端（預覽/實際放置）有一致出口，不需直接碰 GameConfig/Physics 細節。
    ///
    /// 現況（最小可行）：
    /// - 先接 Physics 路徑（OverlapBox）。
    /// - requireCreep/outOfBounds 以可選委派提供，避免硬耦合現有實作。
    /// - useSpatialIndexForPlacement==true 先發出 DEV HUD 提示，未連線時仍以 Physics 結果為準（不破壞流程）。
    ///
    /// 擴充點：
    /// - 設定 RequireCreepPredicate / OutOfBoundsPredicate / SpatialIndexPredicate 來無侵入接線。
    /// </summary>
    public static class PlacementValidator
    {
        /// <summary>
        /// 若設定為 true，且已提供 SpatialIndexPredicate，則 Physics 與 SpatialIndex 需同時通過
        /// </summary>
        public static Func<Bounds, LayerMask, float, bool> SpatialIndexPredicate;

        /// <summary>
        /// 若遊戲規則要求菌毯，則需設定此委派：回傳 true 代表位於菌毯上
        /// </summary>
        public static Func<Bounds, bool> RequireCreepPredicate;

        /// <summary>
        /// 邊界檢查（例如地圖外或禁區）：回傳 true 代表超界
        /// </summary>
        public static Func<Bounds, bool> OutOfBoundsPredicate;

        /// <summary>
        /// 依 GameConfigSO 檢查放置範圍。blockMask：阻擋圖層；extraMargin：呼叫端可臨時外擴。
        /// </summary>
        public static Result<Bounds> ValidateByConfig(Bounds rawBounds, LayerMask blockMask, float extraMargin = 0f)
        {
            var cfg = GameConfigProvider.Current;
            // margin 取較大者，讓呼叫端可臨時收/放
            float margin = Mathf.Max(cfg.margin, extraMargin);

            var bounds = ExpandBounds(rawBounds, margin);

            // 1) 邊界檢查（可選）
            if (OutOfBoundsPredicate != null && OutOfBoundsPredicate.Invoke(bounds))
                return PlacementResults.OutOfBounds("[Placement] Out of bounds");

            // 2) Physics 檢查
            if (HasPhysicsCollision(bounds, blockMask))
                return PlacementResults.Collision("[Placement] Physics collision");

            // 3) SpatialIndex 並聯（可選）
            if (cfg.useSpatialIndexForPlacement)
            {
                if (SpatialIndexPredicate != null)
                {
                    bool spatialOk = SpatialIndexPredicate.Invoke(bounds, blockMask, margin);
                    if (!spatialOk)
                        return PlacementResults.Collision("[Placement] SpatialIndex collision");
                }
                else
                {
                    Debug.LogWarning("[DEV HUD] GameConfig.useSpatialIndexForPlacement=true，但尚未連線 SpatialIndexPredicate；目前僅使用 Physics 結果。");
                }
            }

            // 4) 菌毯要求（可選）
            if (cfg.requireCreep && RequireCreepPredicate != null)
            {
                bool onCreep = RequireCreepPredicate.Invoke(bounds);
                if (!onCreep)
                    return PlacementResults.RequireCreep("[Placement] Require creep");
            }

            // 全數通過
            return PlacementResults.OkBounds(bounds);
        }

        private static Bounds ExpandBounds(Bounds b, float margin)
        {
            if (margin <= 0f) return b;
            var s = b.size;
            s.x += margin * 2f;
            s.y += margin * 2f;
            s.z += margin * 2f;
            b.size = s;
            return b;
        }

        private static bool HasPhysicsCollision(Bounds b, LayerMask blockMask)
        {
            // 使用 OverlapBox 以 bounds 中心/半徑檢查阻擋；忽略 Trigger 以符合放置直覺
            var hits = Physics.OverlapBox(
                b.center,
                b.extents,
                Quaternion.identity,
                blockMask,
                QueryTriggerInteraction.Ignore
            );
            return hits != null && hits.Length > 0;
        }
    }
}

