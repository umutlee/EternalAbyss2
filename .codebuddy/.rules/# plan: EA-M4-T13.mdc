--- FILE: Assets/DeepAbyssHive/Dev/Logging/Editor/SmartConsole.cs ---
#if UNITY_EDITOR
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.RegularExpressions;
using UnityEditor;
using UnityEngine;
using DeepAbyssHive.Core.Logging;

namespace DeepAbyssHive.Dev.Logging.Editor
{
    /// <summary>
    /// DAH Smart Console（Editor 專用）
    /// - 類別 Toggle + Solo
    /// - 關鍵字 Search
    /// - 只顯示 DAH（有分類前綴）
    /// - 折疊（Collapse）
    /// - 自動捲動 / 暫停 / 清除
    /// </summary>
    public class SmartConsole : EditorWindow
    {
        private class Entry
        {
            public DateTime time;
            public int frame;
            public LogType type;
            public string category; // e.g. Game / Terrain / ...
            public string message;
            public string stack;
        }

        private static readonly Regex kPrefix = new Regex(@"^\[(?<cat>[A-Za-z]+)\]\[(?<time>\d{2}:\d{2}:\d{2}\.\d{3})\](\[(?<frame>\d+)\])?\s*", RegexOptions.Compiled);

        // 狀態
        private static readonly List<Entry> _entries = new();
        private Vector2 _scroll;
        private string _search = "";
        private bool _onlyDAH = false;
        private bool _pause = false;
        private bool _autoScroll = true;
        private bool _collapse = false;

        // 分類控制
        private readonly string[] _cats = Enum.GetNames(typeof(LogCategory));
        private readonly Dictionary<string, bool> _catOn = new();
        private string _soloCat = null; // Solo 模式：非空時只顯示該分類

        [MenuItem("DeepAbyssHive/Tools/Smart Console")]
        private static void Open()
        {
            var wnd = GetWindow<SmartConsole>("Smart Console");
            wnd.minSize = new Vector2(680, 340);
        }

        private void OnEnable()
        {
            _catOn.Clear();
            foreach (var c in _cats)
                _catOn[c] = true;

            Application.logMessageReceived -= HandleLog;
            Application.logMessageReceived += HandleLog;
        }

        private void OnDisable()
        {
            Application.logMessageReceived -= HandleLog;
        }

        private void HandleLog(string condition, string stackTrace, LogType type)
        {
            if (_pause) return;

            var e = new Entry
            {
                time = DateTime.Now,
                frame = Time.frameCount,
                type = type,
                stack = stackTrace ?? string.Empty
            };

            // 解析前綴
            var m = kPrefix.Match(condition ?? string.Empty);
            if (m.Success)
            {
                e.category = m.Groups["cat"].Value;
                // 去掉前綴後保留訊息
                e.message = condition.Substring(m.Length);
            }
            else
            {
                e.category = "Other";
                e.message = condition ?? string.Empty;
            }

            _entries.Add(e);
            if (_autoScroll) Repaint();
        }

        private IEnumerable<Entry> Filtered()
        {
            IEnumerable<Entry> q = _entries;

            if (_onlyDAH)
                q = q.Where(e => e.category != "Other");

            if (!string.IsNullOrEmpty(_soloCat))
            {
                q = q.Where(e => e.category == _soloCat);
            }
            else
            {
                q = q.Where(e => _catOn.TryGetValue(e.category, out var on) ? on : true);
            }

            if (!string.IsNullOrEmpty(_search))
            {
                q = q.Where(e => e.message.IndexOf(_search, StringComparison.OrdinalIgnoreCase) >= 0);
            }

            return _collapse
                ? q.GroupBy(e => (e.type, e.category, e.message)).Select(g => g.First())
                : q;
        }

        private void OnGUI()
        {
            using (new EditorGUILayout.HorizontalScope(EditorStyles.toolbar))
            {
                if (GUILayout.Button("Clear", EditorStyles.toolbarButton, GUILayout.Width(60)))
                    _entries.Clear();

                _pause = GUILayout.Toggle(_pause, "Pause", EditorStyles.toolbarButton, GUILayout.Width(60));
                _autoScroll = GUILayout.Toggle(_autoScroll, "Auto", EditorStyles.toolbarButton, GUILayout.Width(50));
                _collapse = GUILayout.Toggle(_collapse, "Collapse", EditorStyles.toolbarButton, GUILayout.Width(70));

                GUILayout.Space(8);
                GUILayout.Label("Search", GUILayout.Width(48));
                _search = GUILayout.TextField(_search, EditorStyles.toolbarTextField, GUILayout.Width(200));

                GUILayout.FlexibleSpace();
                _onlyDAH = GUILayout.Toggle(_onlyDAH, "Only DAH", EditorStyles.toolbarButton, GUILayout.Width(80));

                // Solo 選擇器
                GUILayout.Space(8);
                GUILayout.Label("Solo", GUILayout.Width(30));
                int cur = string.IsNullOrEmpty(_soloCat) ? 0 : Array.IndexOf(_cats, _soloCat);
                string[] soloOpts = new string[] { "(Off)" }.Concat(_cats).ToArray();
                int sel = EditorGUILayout.Popup(cur < 0 ? 0 : cur + 1, soloOpts, GUILayout.Width(120));
                _soloCat = sel <= 0 ? null : soloOpts[sel];
            }

            // 類別切換列（非 Solo 模式可用）
            if (string.IsNullOrEmpty(_soloCat))
            {
                using (new EditorGUILayout.HorizontalScope())
                {
                    foreach (var c in _cats)
                    {
                        bool on = _catOn[c];
                        bool next = GUILayout.Toggle(on, c, "Button");
                        if (next != on) _catOn[c] = next;
                    }
                }
            }
            else
            {
                EditorGUILayout.HelpBox($"Solo: 只顯示 {_soloCat} 類別（上方下拉可切換/關閉）", MessageType.Info);
            }

            // 列表
            _scroll = EditorGUILayout.BeginScrollView(_scroll);
            foreach (var e in Filtered())
            {
                var style = e.type switch
                {
                    LogType.Warning => EditorStyles.helpBox,
                    LogType.Error or LogType.Exception or LogType.Assert => EditorStyles.textArea,
                    _ => EditorStyles.label
                };

                using (new EditorGUILayout.HorizontalScope())
                {
                    GUILayout.Label(e.time.ToString("HH:mm:ss.fff"), GUILayout.Width(90));
                    GUILayout.Label($"[{e.type}]".PadRight(8), GUILayout.Width(60));
                    GUILayout.Label(e.category, GUILayout.Width(90));
                    GUILayout.Label(e.message, style);
                }
            }
            if (_autoScroll && Event.current.type == EventType.Repaint)
                _scroll.y = float.MaxValue;
            EditorGUILayout.EndScrollView();
        }
    }
}
#endif
