using System;
using System.Collections.Generic;
using UnityEngine;

namespace DeepAbyssHive.QA.Smoke.Dev.HUD
{
    /// <summary>
    /// 建築目錄 HUD（可拖拽 + 熱鍵循環）
    /// - C（或 GameConfig.buildingMenuToggleKey）開關視窗
    /// - Tab / BackQuote（或 GameConfig.buildingCycleNextKey/Prev）循環切換
    /// - 透過 BuildingCatalogBinder 進行選取，同步預覽與放置
    /// </summary>
    public sealed class BuildingCatalogHUD : MonoBehaviour
    {
        private const string RectPrefKey = "DAH.BuildingCatalogHUD.Rect";
        private Rect _rect = new Rect(540, 280, 600, 120);
        private bool _visible = false;
        private Vector2 _scroll;
        private KeyCode _toggleKey = KeyCode.C;
        private KeyCode _nextKey = KeyCode.Tab;
        private KeyCode _prevKey = KeyCode.BackQuote;

        private DeepAbyssHive.Buildings.Runtime.BuildingCatalogBinder _binder;

        private void Awake()
        {
            LoadRect();
            _binder = FindObjectOfType<DeepAbyssHive.Buildings.Runtime.BuildingCatalogBinder>();
            ReadKeysFromGameConfig();
        }

        private void Update()
        {
            // 熱鍵：開關
            if (Input.GetKeyDown(_toggleKey))
            {
                _visible = !_visible;
                SmartLog("HUD", $"BuildingCatalogHUD visible={_visible}");
                SaveRect();
            }

            // 熱鍵：循環（即使 HUD 關閉時也可作用）
            if (Input.GetKeyDown(_nextKey)) TryCycle(+1);
            if (Input.GetKeyDown(_prevKey)) TryCycle(-1);
        }

        private void TryCycle(int delta)
        {
            if (_binder == null) _binder = FindObjectOfType<DeepAbyssHive.Buildings.Runtime.BuildingCatalogBinder>();
            if (_binder != null)
            {
                var m = _binder.GetType().GetMethod("Cycle", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);
                if (m != null) m.Invoke(_binder, new object[] { delta });
            }
        }

        private void OnGUI()
        {
            if (!_visible) return;
            _rect = GUI.Window(0xDA17F001, _rect, DrawWindow, "Building Catalog");
        }

        private void DrawWindow(int id)
        {
            GUILayout.Label("Click a building to select. (Tab/BackQuote hotkeys still work)");

            if (_binder == null)
                _binder = FindObjectOfType<DeepAbyssHive.Buildings.Runtime.BuildingCatalogBinder>();

            var entries = GetEntries();
            _scroll = GUILayout.BeginScrollView(_scroll, GUILayout.Height(40));
            GUILayout.BeginHorizontal();
            for (int i = 0; i < entries.Count; i++)
            {
                var label = $"{i:00}  {entries[i]}";
                if (GUILayout.Button(label, GUILayout.MinWidth(140)))
                {
                    SelectIndex(i);
                }
            }
            GUILayout.EndHorizontal();
            GUILayout.EndScrollView();

            GUILayout.BeginHorizontal();
            if (GUILayout.Button("Prev")) TryCycle(-1);
            if (GUILayout.Button("Next")) TryCycle(+1);
            GUILayout.FlexibleSpace();
            if (GUILayout.Button("Close", GUILayout.Width(80))) { _visible = false; SaveRect(); }
            GUILayout.EndHorizontal();

            // 讓整個標題列可拖拽
            GUI.DragWindow(new Rect(0, 0, 10000, 20));
        }

        private List<string> GetEntries()
        {
            var list = new List<string>();
            if (_binder == null) return list;
            var prop = _binder.GetType().GetProperty("CatalogEntries",
                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);
            if (prop != null)
            {
                var arr = prop.GetValue(_binder) as System.Collections.IEnumerable;
                if (arr != null)
                {
                    foreach (var e in arr) list.Add(e?.ToString() ?? "(null)");
                }
            }
            return list;
        }

        private void SelectIndex(int idx)
        {
            if (_binder == null) return;
            var m = _binder.GetType().GetMethod("Select", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);
            if (m != null) m.Invoke(_binder, new object[] { idx });
        }

        private void ReadKeysFromGameConfig()
        {
            try
            {
                var cfg = Resources.Load("Configs/GameConfig");
                if (cfg == null) return;
                var t = cfg.GetType();
                _toggleKey = ReadKey(t, cfg, "buildingMenuToggleKey") ?? _toggleKey;
                _nextKey   = ReadKey(t, cfg, "buildingCycleNextKey") ?? _nextKey;
                _prevKey   = ReadKey(t, cfg, "buildingCyclePrevKey") ?? _prevKey;
                SmartLog("CONFIG", $"BuildingCatalogHUD keys → toggle={_toggleKey}, next={_nextKey}, prev={_prevKey}");
            }
            catch { /* ignore */ }
        }

        private static KeyCode? ReadKey(Type t, object o, string name)
        {
            var fi = t.GetField(name, System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.IgnoreCase);
            if (fi != null && fi.FieldType == typeof(KeyCode)) return (KeyCode)fi.GetValue(o);
            var pi = t.GetProperty(name, System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.IgnoreCase);
            if (pi != null && pi.PropertyType == typeof(KeyCode)) return (KeyCode)pi.GetValue(o, null);
            return null;
        }

        private void LoadRect()
        {
#if UNITY_EDITOR
            string s = UnityEditor.EditorPrefs.GetString(RectPrefKey, string.Empty);
#else
            string s = PlayerPrefs.GetString(RectPrefKey, string.Empty);
#endif
            if (string.IsNullOrEmpty(s)) return;
            var parts = s.Split(',');
            if (parts.Length == 4 &&
                float.TryParse(parts[0], out var x) &&
                float.TryParse(parts[1], out var y) &&
                float.TryParse(parts[2], out var w) &&
                float.TryParse(parts[3], out var h))
                _rect = new Rect(x, y, w, h);
        }

        private void SaveRect()
        {
            string s = $"{_rect.x:F0},{_rect.y:F0},{_rect.width:F0},{_rect.height:F0}";
#if UNITY_EDITOR
            UnityEditor.EditorPrefs.SetString(RectPrefKey, s);
#else
            PlayerPrefs.SetString(RectPrefKey, s);
            PlayerPrefs.Save();
#endif
        }

        private static void SmartLog(string cat, string msg)
        {
            // 輕量橋接 DAHLog（若不存在則降級一次）
            var dah = Type.GetType("DeepAbyssHive.Core.Logging.DAHLog, Assembly-CSharp");
            if (dah != null)
            {
                var m = dah.GetMethod("Info", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Static);
                var catEnum = Type.GetType("DeepAbyssHive.Core.Logging.LogCategory, Assembly-CSharp");
                object service = Enum.Parse(catEnum ?? typeof(System.Enum), "HUD", true);
                m?.Invoke(null, new object[]{ service, $"[CatalogHUD] {msg}", null });
            }
            else
            {
                Debug.Log($"[HUD][CatalogHUD] {msg}");
            }
        }
    }
}
