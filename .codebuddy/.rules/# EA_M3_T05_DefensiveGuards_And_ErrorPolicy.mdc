+using UnityEngine;
+using DeepAbyssHive.Core.Time;
+
+namespace DeepAbyssHive.Core.Save.Participants
+{
+    /// <summary>
+    /// v1 範例參與者：保存/還原 TimeService 狀態（Paused/Scale）。
+    /// 自動隨遊戲啟動創建並掛到 Managers。
+    /// </summary>
+    public class TimeServiceSaveParticipant : MonoBehaviour, DeepAbyssHive.Core.Save.ISaveParticipant
+    {
+        public string Key => "time.service";
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+        private static void AutoCreate()
+        {
+            if (FindObjectOfType<TimeServiceSaveParticipant>() != null) return;
+            var go = new GameObject("SaveP-TimeService"); go.AddComponent<TimeServiceSaveParticipant>();
+            var managers = GameObject.Find("Managers"); if (managers != null) go.transform.SetParent(managers.transform);
+            DontDestroyOnLoad(go);
+        }
+
+        [System.Serializable]
+        public class State
+        {
+            public bool paused;
+            public float scale;
+        }
+
+        public object CaptureState()
+        {
+            return new State { paused = TimeService.IsPaused, scale = TimeService.TimeScale };
+        }
+
+        public void RestoreState(object state)
+        {
+            if (state is State s)
+            {
+                if (s.paused) TimeService.Pause(); else TimeService.Resume();
+                TimeService.SetTimeScale(Mathf.Max(0.0001f, s.scale));
+            }
+        }
+    }
+}
