# ===============================
# 0) 通用：為 ConfigManager 補齊常用 API（GetConfig / GetConfigOrDefault / IsRegistered）
# ===============================
WRITE_CHANGE: Assets/DeepAbyssHive/Core/Config/ConfigManager.Extensions.cs <<<=csharp
using System;

namespace DeepAbyssHive.Core.Config
{
    // 以擴充方法形式提供；若專案內已有正式版本，編譯器會採用更特定/同名的方法，本檔作為 fallback。
    public static class ConfigManagerExtensions
    {
        public static T GetConfig<T>(this ConfigManager manager) where T : class
        {
            if (manager == null) return null;
            try { return manager.Get(typeof(T)) as T; } catch { return null; }
        }

        public static T GetConfigOrDefault<T>(this ConfigManager manager) where T : class, new()
        {
            var cfg = manager.GetConfig<T>();
            return cfg ?? new T();
        }

        // 有些呼叫看起來傳 1 個引數（如 key 或型別名稱），統一提供 fallback。
        public static bool IsRegistered(this ConfigManager manager, string key)
        {
            try { return manager?.Has(key) ?? false; } catch { return false; }
        }

        public static bool IsRegistered<T>(this ConfigManager manager)
        {
            return manager.IsRegistered(typeof(T).Name);
        }
    }
}
>>>

