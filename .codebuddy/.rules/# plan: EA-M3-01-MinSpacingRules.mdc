# PLAN
# - 在 PlacementValidator 中新增「minSpacing」檢查：
#   * 若 GameConfigSO.minSpacing > 0，將額外做一次距離檢查，不依賴 margin。
#   * 預設用 Physics.OverlapSphere 作為快徑（排除 Terrain/IgnoreRaycast 等你現有遮罩）。
#   * 如果已接 SpatialIndexPredicate，也能共存；任何一條失敗都視為 E_PLACE_COLLISION。
# - 單檔、少量增補，保持回溯相容；未設定 minSpacing 時行為完全不變。
# CHANGES
PATCH: DeepAbyssHive/Common/Placement/PlacementValidator.cs
*** /a/DeepAbyssHive/Common/Placement/PlacementValidator.cs
--- /b/DeepAbyssHive/Common/Placement/PlacementValidator.cs
@@
-        public static Result<Bounds> ValidateByConfig(Bounds rawBounds, LayerMask blockMask, float extraMargin = 0f)
+        public static Result<Bounds> ValidateByConfig(Bounds rawBounds, LayerMask blockMask, float extraMargin = 0f)
         {
             var cfg = GameConfigProvider.Current;
             // margin 取較大者，讓呼叫端可臨時收/放
             float margin = Mathf.Max(cfg.margin, extraMargin);
 
             var bounds = ExpandBounds(rawBounds, margin);
@@
