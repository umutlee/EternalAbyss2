 private static Color GetTintFromResult(Result<Bounds> r)
 {
   if (r == null) return Color.white;
   if (r.ok) return Color.green;
   switch (r.code)
   {
       case PlaceResultCode.E_PLACE_COLLISION: return Color.red;
       case PlaceResultCode.E_REQUIRE_CREEP:   return Color.yellow;
       case PlaceResultCode.E_OUT_OF_BOUNDS:   return new Color(1f,0f,1f);
       case PlaceResultCode.E_INVALID_TYPE:    return Color.cyan;
       default: return Color.white;
   }
 }

