# 將 ServiceLocator 常被呼叫但缺的方法補上（以 wrapper 形式，不破壞既有 register/get）
# 若專案裡已經有 ServiceLocator 的 partial，這支檔案就能直接併入。
- add_file: Assets/DeepAbyssHive/Core/Services/ServiceLocator.Compat.partial.cs
  content: |
    using System;
    using System.Collections.Generic;

    namespace DeepAbyssHive.Core.Services
    {
        public static partial class ServiceLocator
        {
            private static readonly Dictionary<Type, object> _compat = _compat ?? new();

            public static void Register<T>(T instance) where T : class
            {
                _compat[typeof(T)] = instance!;
            }

            public static bool IsRegistered<T>() where T : class
            {
                return _compat.ContainsKey(typeof(T));
            }

            public static bool IsInitialized<T>() where T : class
            {
                // 與 IsRegistered 等價，作為相容別名
                return IsRegistered<T>();
            }

            public static void MarkAsInitialized<T>() where T : class
            {
                // 相容性 no-op
            }

            public static string GetStatusInfo()
            {
                return $"Registered services: {_compat.Count}";
            }

            public static T Get<T>() where T : class
            {
                if (_compat.TryGetValue(typeof(T), out var svc) && svc is T typed) return typed;
                throw new DeepAbyssHive.Core.Exceptions.ServiceNotFoundException($"Service not found: {typeof(T).FullName}");
            }
        }
    }

