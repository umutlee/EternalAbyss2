python3 - << 'PY'
import os, re, sys, pathlib, textwrap, glob

root = "Eternal Abyss 2"
if not os.path.isdir(root):
    print("ERROR: Project root not found:", root)
    sys.exit(1)

# 1) 定位 UnitQueryService 檔與命名空間
uqs_files = []
for p in pathlib.Path(root).rglob("Assets/DeepAbyssHive/**/UnitQueryService.cs"):
    uqs_files.append(str(p))
if not uqs_files:
    # 寬鬆尋找
    for p in pathlib.Path(root).rglob("UnitQueryService.cs"):
        uqs_files.append(str(p))
if not uqs_files:
    print("ERROR: UnitQueryService.cs not found")
    sys.exit(1)
uqs_path = uqs_files[0]
code = open(uqs_path, "r", encoding="utf-8", errors="ignore").read()
m = re.search(r'namespace\s+([A-Za-z0-9_.]+)', code)
ns = m.group(1) if m else None
if not ns:
    print("ERROR: namespace not found in", uqs_path)
    sys.exit(1)
out_dir = os.path.dirname(uqs_path)

# 2) 找 interface 定義檔
def find_interface_paths(name):
    hits = []
    for p in pathlib.Path(root).rglob("*.cs"):
        try:
            txt = open(p, "r", encoding="utf-8", errors="ignore").read()
        except:
            continue
        if re.search(rf'\binterface\s+{re.escape(name)}\b', txt):
            hits.append((str(p), txt))
    return hits

interfaces = {}
for iname in ["IUnitQueryService", "IQueryService"]:
    hits = find_interface_paths(iname)
    if not hits:
        print(f"WARNING: Interface {iname} not found; skip")
        continue
    # 取最可能的一個（優先 DeepAbyssHive/Units 路徑）
    hits.sort(key=lambda t: (0 if "/Units/" in t[0].replace("\\","/") else 1, len(t[0])))
    interfaces[iname] = hits[0]

if not interfaces:
    print("ERROR: No interfaces found to implement")
    sys.exit(1)

def extract_namespace(txt):
    m = re.search(r'namespace\s+([A-Za-z0-9_.]+)', txt)
    return m.group(1) if m else None

def extract_interface_block(txt, iname):
    # 取 interface 區塊（支援單檔多介面）
    pat = rf'\binterface\s+{re.escape(iname)}\b[^{{]*{{'
    m = re.search(pat, txt)
    if not m: return None
    start = m.end()
    # 找對應大括號結束
    depth = 1
    i = start
    while i < len(txt):
        if txt[i] == '{':
            depth += 1
        elif txt[i] == '}':
            depth -= 1
            if depth == 0:
                return txt[start:i]
        i += 1
    return None

def clean(sig):
    # 移除多餘空白、換行；保留泛型與修飾
    sig = re.sub(r'//.*', '', sig)           # 單行註解
    sig = re.sub(r'/\*.*?\*/', '', sig, flags=re.S)  # 區塊註解
    sig = sig.strip()
    sig = re.sub(r'\s+', ' ', sig)
    return sig

def split_members(block):
    # 以 ';' 分割介面成員（方法或屬性宣告以 ';' 結尾）
    # 先去掉 attributes 區塊以避免干擾
    tmp = re.sub(r'\[[^\]]*\]', '', block)
    # 合併行
    tmp = re.sub(r'\s*\n\s*', ' ', tmp)
    members = []
    cur = ""
    depth = 0
    for ch in tmp:
        cur += ch
        if ch == '<': depth += 1
        elif ch == '>': depth = max(depth-1,0)
        elif ch == ';' and depth == 0:
            members.append(clean(cur[:-1]))
            cur = ""
    return [m for m in members if m and not m.startswith("event ")]

def is_property(sig):
    # 屬性通常長這樣： "Type Name { get; set; }"
    return '{' in sig and '}' in sig and '(' not in sig

def gen_method_impl(iname, sig):
    # 例： "ReturnType MethodName(Type1 a, Type2 b)"
    # 也可能有修飾詞：new/static? 介面內不會 static
    # 去掉多餘修飾
    s = sig
    # 取返回型別與方法名
    m = re.match(r'(?:public|protected|internal|private|new|virtual|abstract|override|static|extern|partial|\s)*(.+?)\s+([A-Za-z_][A-Za-z0-9_\.]*)\s*\((.*)\)', s)
    if not m:
        return None
    ret, name, param = m.groups()
    ret = ret.strip()
    name = name.strip()
    param = param.strip()
    # 顯式介面實作
    if ret == "void":
        body = f"void {iname}.{name}({param}) {{ }}"
    else:
        body = f"{ret} {iname}.{name}({param}) => default;"
    return body

def gen_property_impl(iname, sig):
    # 例："bool IsQueryAvailable { get; }" 或 "Foo Bar { get; set; }"
    s = sig
    # 取 return type 與名稱
    m = re.match(r'(?:public|protected|internal|private|new|virtual|abstract|override|static|extern|partial|\s)*(.+?)\s+([A-Za-z_][A-Za-z0-9_]*)\s*{(.*)}', s)
    if not m:
        return None
    rtype, name, acc = m.groups()
    acc = acc.strip()
    has_get = 'get;' in acc
    has_set = 'set;' in acc
    if has_get and has_set:
        impl = f"""{rtype} {iname}.{name} {{ get => default; set {{ }} }}"""
    elif has_get:
        impl = f"""{rtype} {iname}.{name} {{ get => default; }}"""
    else:
        # 罕見僅 set; 的屬性
        impl = f"""{rtype} {iname}.{name} {{ set {{ }} }}"""
    return impl

# 3) 生成實作
using_ns = set(["System", "System.Collections.Generic", "UnityEngine"])
impls = []
for iname, (ipath, itxt) in interfaces.items():
    ins = extract_namespace(itxt)
    if ins: using_ns.add(ins)
    block = extract_interface_block(itxt, iname)
    if not block:
        print("WARNING: cannot extract block for", iname)
        continue
    members = split_members(block)
    for mem in members:
        impl = gen_property_impl(iname, mem) if is_property(mem) else gen_method_impl(iname, mem)
        if impl:
            impls.append(impl)

if not impls:
    print("ERROR: no members parsed from interfaces")
    sys.exit(1)

header = "\n".join(sorted(f"using {u};" for u in using_ns)) + "\n"
body = "\n    ".join(impls)
out = f"""{header}
namespace {ns}
{{
    // Auto-generated compat stubs for UnitQueryService (explicit interface implementations).
    // Purpose: restore compilation with minimal, no-op behavior.
    public partial class UnitQueryService
    {{
        {body}
    }}
}}
"""

out_path = os.path.join(out_dir, "UnitQueryService_Compat.cs")
with open(out_path, "w", encoding="utf-8") as f:
    f.write(out)
print("WROTE:", out_path)
PY

