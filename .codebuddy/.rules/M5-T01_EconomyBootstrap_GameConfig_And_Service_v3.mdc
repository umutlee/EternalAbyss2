using UnityEngine;

namespace DeepAbyssHive.Core.Config
{
    /// <summary>
    /// 將經濟相關參數外掛到 GameConfig（partial），避免動到原檔。
    /// </summary>
    public sealed partial class GameConfigSO : ScriptableObject
    {
        [Header("Economy / Resources")]
        [Tooltip("是否啟用資源系統（MVP 核心）。")]
        public bool resourcesEnabled = true;

        [Tooltip("初始 Biomass。")]
        public int startBiomass = 200;

        [Tooltip("初始 Energy。")]
        public int startEnergy = 0;

        [Tooltip("Dev：快捷鍵增加 Biomass（僅本地開發驗證）。")]
        public KeyCode debugAddBiomassKey = KeyCode.F5;

        [Tooltip("Dev：每次增加 Biomass 的數量。")]
        public int debugAddBiomassAmount = 100;
    }
}
