private static int[,] ToIntGrid(DeepAbyssHive.Terrain.Enums.TerrainType[,] src)
{
    int w = src.GetLength(0), h = src.GetLength(1);
    var dst = new int[w, h];
    for (int i = 0; i < w; i++)
        for (int j = 0; j < h; j++)
            dst[i, j] = (int)src[i, j];
    return dst;
}


